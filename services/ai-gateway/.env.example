PORT=8787
# Required. The gateway refuses to start without it.
GATEWAY_AUTH_TOKEN=replace-with-a-local-development-token
# Comma-separated exact origins allowed to call the gateway from a browser.
# Empty means no cross-origin request is permitted. Never use "*".
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 to require inputHash to match the submitted transcript.
GATEWAY_VERIFY_INPUT_HASH=0
# Provider credentials belong only in a secret manager or local untracked .env.
